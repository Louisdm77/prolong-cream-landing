# Copy this file to .env (or set these in Vercel / Netlify) and fill in.

# Meta (Facebook) Pixel IDs, comma separated. Leave empty and no pixel loads.
VITE_FB_PIXEL_IDS=

# Email address that receives orders (through formsubmit.co). Leave empty to use the one in src/config.js.
VITE_ORDER_EMAIL=

# Optional: send orders to your own URL instead of email (must accept a JSON POST).
VITE_ORDER_ENDPOINT=
