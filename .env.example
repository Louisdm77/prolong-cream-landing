# Copy this file to .env (or set these in Vercel / Netlify) and fill in.

# Meta (Facebook) Pixel IDs, comma separated. Leave empty to use the IDs in src/config.js.
VITE_FB_PIXEL_IDS=

# Where orders are sent. Any URL that accepts a JSON POST works:
# Formspree, a Google Apps Script web app (Google Sheets), Make, Zapier, your own API.
VITE_ORDER_ENDPOINT=

# Optional. WhatsApp number in international format, digits only (e.g. 2348012345678).
# If set, the customer is also sent to WhatsApp with the order pre-filled.
VITE_WHATSAPP_NUMBER=
